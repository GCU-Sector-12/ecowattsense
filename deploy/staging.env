# Staging settings for EcoWattSense.
# The staging deploy applies this file to .env on the VM on every deploy.
# Change a setting with a pull request. After the merge, the next deploy applies it.
# THIS REPOSITORY IS PUBLIC, so everything in this file is public too.
# The VM keeps its own keys (bind address, ports, user ids). Those lines are ignored here.
ECOWATTSENSE_DASHBOARD_DATA_SOURCE=stub

# Admin session length in seconds (PR 33, EWS_API-10). 28800 is 8 hours.
ECOWATTSENSE_SESSION_LIFETIME_SECONDS=28800
