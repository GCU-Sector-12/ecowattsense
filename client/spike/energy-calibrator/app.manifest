<?xml version="1.0" encoding="utf-8"?>
<!--
  app.manifest: application manifest of EnergyCalibrator.
  Who uses it: Windows reads it when the program starts. "asInvoker" means the program runs with the rights of the
  user who started it, so a student without administrator rights can run it. Only the Intel DTT reading needs
  administrator rights; the program offers a button that restarts it elevated.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
