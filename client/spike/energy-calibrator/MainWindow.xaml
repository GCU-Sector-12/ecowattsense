<!--
  MainWindow.xaml: the one window of EnergyCalibrator. Top: instructions and the live readings of every source.
  Middle: the phase list with a progress bar per phase, and the results table. Bottom: status line and the buttons.
  Who uses it: App.xaml opens it. MainWindow.xaml.cs fills it. The window has no text input fields.
-->
<Window x:Class="EnergyCalibrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Energy Calibrator" Width="1220" Height="900" MinWidth="1000" MinHeight="740"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DEE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <DataTemplate x:Key="ReadingTemplate">
            <Grid Margin="0,1" ToolTip="{Binding Hint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="#4B5563" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Energy Calibrator" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Measures how much power this laptop uses in each state, from the battery alone." Foreground="#4B5563" Margin="0,2,0,8" />
                <TextBlock x:Name="InstructionText" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Live readings (every 2 seconds)" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl x:Name="ReadingsList" ItemTemplate="{StaticResource ReadingTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <TabControl x:Name="Tabs">
                <TabItem Header="Test phases">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <StackPanel x:Name="PhaseStack" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Results">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                                  Background="White" RowBackground="White" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phase" Binding="{Binding Name}" Width="170" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                                <DataGridTextColumn Header="Samples" Binding="{Binding Samples}" />
                                <DataGridTextColumn Header="Seconds" Binding="{Binding Seconds}" />
                                <DataGridTextColumn Header="Drop (mWh)" Binding="{Binding Drop}" />
                                <DataGridTextColumn Header="Battery W (IOCTL)" Binding="{Binding WattsIoctl}" />
                                <DataGridTextColumn Header="Battery W (WMI)" Binding="{Binding WattsWmi}" />
                                <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu}" />
                                <DataGridTextColumn Header="CPU pkg W (DTT)" Binding="{Binding CpuPackage}" />
                                <DataGridTextColumn Header="CPU share %" Binding="{Binding Share}" />
                                <DataGridTextColumn Header="GPU 3D %" Binding="{Binding Gpu}" />
                                <DataGridTextColumn Header="Screen %" Binding="{Binding Brightness}" />
                                <DataGridTextColumn Header="Zone temp C" Binding="{Binding ZoneTemp}" />
                                <DataGridTextColumn Header="DTT pkg C" Binding="{Binding PackageTemp}" />
                                <DataGridTextColumn Header="Warnings" Binding="{Binding Warning}" Width="420" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="Power model" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl x:Name="ModelList" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,0,10" />

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="StartButton" Content="Start" Click="OnStartClick" IsEnabled="False" FontWeight="SemiBold" />
            <Button x:Name="StopButton" Content="Stop" Click="OnStopClick" IsEnabled="False" />
            <Button x:Name="AdminButton" Content="Restart as administrator (for Intel DTT)" Click="OnAdminClick" />
            <Button x:Name="FolderButton" Content="Open results folder" Click="OnFolderClick" />
        </StackPanel>
    </Grid>
</Window>
