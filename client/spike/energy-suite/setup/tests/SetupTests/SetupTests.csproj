<!--
  SetupTests.csproj: console tests of Setup.exe. Run by scripts\Test-Setup.ps1. The exit code is the number of failed checks.
  It targets net10.0-windows because the Setup project it tests is a WPF project.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SetupTests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EcoWattSense.Setup\EcoWattSense.Setup.csproj" />
  </ItemGroup>

</Project>
