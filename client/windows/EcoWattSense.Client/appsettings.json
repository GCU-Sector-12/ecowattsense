{
  "Server": {
    "Enabled": false
  },
  "Reporting": {
    "IntervalSeconds": 300
  },
  "StateClassification": {
    "IdleThresholdSeconds": 600,
    "UnusedThresholdSeconds": 3600
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "StartupSettings": "Information",
        "DeviceIdentity": "Information",
        "ActivityHistory": "Information",
        "JsonReports": "Information",
        "TextReport": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
