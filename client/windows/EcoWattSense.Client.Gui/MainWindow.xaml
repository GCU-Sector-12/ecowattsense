<Window x:Class="EcoWattSense.Client.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcoWattSense"
        Width="1000" Height="700"
        MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI"
        Foreground="#142B26">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#728095"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#123C32">
            <Grid Margin="22,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="EcoWattSense"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"/>
                    <TextBlock Text="Computer Energy Monitor"
                               Foreground="#C1D8CF"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#285E50"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,36,0,0">
                    <TextBlock Text="This computer"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                </Border>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="Save Energy,"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="A Greener Tomorrow"
                               Foreground="#C1D8CF"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,28,16,24">
                <TextBlock Text="This computer"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Your computer's activity and monitoring status."
                           Foreground="#728095"
                           FontSize="14"
                           Margin="0,8,0,24"/>

                <UniformGrid Columns="2" Rows="2">
                    <Border Style="{StaticResource Card}"
                            Background="#E5F5E8">
                        <StackPanel>
                            <TextBlock Text="User activity"
                                       Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ActivityValue"
                                       Text="Unavailable"
                                       Style="{StaticResource Value}"/>
                            <TextBlock Text="Based on mouse and keyboard inactivity"
                                       FontSize="12"
                                       Foreground="#52685D"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CPU usage"
                                       Style="{StaticResource Label}"/>
                            <TextBlock x:Name="CpuValue"
                                       Text="Unavailable"
                                       Style="{StaticResource Value}"/>
                            <ProgressBar x:Name="CpuBar"
                                         Minimum="0" Maximum="100"
                                         Value="0" Height="8"
                                         Foreground="#2FA441"
                                         Background="#E5E9EC"
                                         Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Background="#FFF5DC">
                        <StackPanel>
                            <TextBlock Text="Time since last input"
                                       Style="{StaticResource Label}"/>
                            <TextBlock x:Name="InactivityValue"
                                       Text="Unavailable"
                                       Style="{StaticResource Value}"/>
                            <TextBlock Text="No input does not always mean wasted energy."
                                       FontSize="12"
                                       Foreground="#746746"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Power source"
                                       Style="{StaticResource Label}"/>
                            <TextBlock x:Name="PowerValue"
                                       Text="Unavailable"
                                       Style="{StaticResource Value}"/>
                            <TextBlock x:Name="ScreenValue"
                                       Text="Screen lock: unknown"
                                       Foreground="#728095"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Reports"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <TextBlock x:Name="LastSavedValue"
                                   Text="Last saved: not yet connected"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="LastSentValue"
                                   Text="Last accepted by server: not yet connected"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="ReportStatusValue"
                                   Text="Monitoring has not started."
                                   Foreground="#728095"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="UpdatedValue"
                           Text="Waiting for monitoring data"
                           Foreground="#728095"
                           FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
