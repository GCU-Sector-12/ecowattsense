<Window x:Class="EcoWattSense.Client.Gui.Settings.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename this computer"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="Rename this computer" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <TextBlock Text="Computer name" FontSize="12" Foreground="#52685D" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox"
                 HorizontalAlignment="Stretch"
                 HorizontalContentAlignment="Left"
                 Padding="6,5"
                 TextChanged="OnNameChanged"/>
        <TextBlock Text="Up to 60 characters."
                   FontSize="12" Foreground="#52685D" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock x:Name="ReasonText" FontSize="12" Foreground="#A33A2E" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Save" Padding="18,6" IsDefault="True" Click="OnSaveClick"/>
            <Button Content="Cancel" Padding="18,6" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
