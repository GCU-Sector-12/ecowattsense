<Project Sdk="Microsoft.NET.Sdk">
  <!-- DeveloperPage: plain console tests of the Developer page logic (no WPF and no Windows). The exit code is the number of failed checks.
       It compiles the logic files of EcoWattSense.Client.Gui/Developer/Logic from the GUI project.
       Run it with dotnet run on this project (see the client README). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../EcoWattSense.Client.Gui/Developer/Logic/*.cs" LinkBase="Logic" />
  </ItemGroup>
</Project>
