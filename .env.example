# Copy this file to .env and fill in your own values.
# .env is ignored by Git. Never commit real values.
ECOWATTSENSE_SERVER_URL=http://localhost:8000
ECOWATTSENSE_DB_PATH=./data/ecowattsense.db
EWS_CLIENT_KEY=

# Host port of the dashboard container and the address it is published on.
# 127.0.0.1 on a laptop. On the staging VM use the docker0 address (ip -4 addr show docker0), so the tunnel container can reach it.
ECOWATTSENSE_FRONT_PORT=8081
ECOWATTSENSE_FRONT_BIND=127.0.0.1

# User and group id of the server container. Must own ./data, so use your own ids on the VM (id -u, id -g).
ECOWATTSENSE_UID=1000
ECOWATTSENSE_GID=1000
