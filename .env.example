# Copy this file to .env and fill in your own values.
# .env is ignored by Git. Never commit real values.
ECOWATTSENSE_SERVER_URL=http://localhost:8000
ECOWATTSENSE_DB_PATH=./data/ecowattsense.db
ECOWATTSENSE_API_KEY=

# Host port of the dashboard container. Published on 127.0.0.1 only.
ECOWATTSENSE_FRONT_PORT=8081
